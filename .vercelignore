# Keep the Vercel deployment a clean, Python-only project so the platform
# builds app.py with the Python runtime instead of mis-detecting Node.

# Node tooling is only used locally for the Playwright browser test.
package.json
package-lock.json
node_modules/

# Tests and CI are not part of the deployed app.
tests/
.github/

# Local container / editor / agent tooling.
Dockerfile
.dockerignore
.idea/
.agent/

# Generated artifacts and caches.
output/
__pycache__/
*.pyc
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
