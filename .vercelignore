# Keep the Vercel deployment lean: ship the Next.js app, the api/ function,
# and the stock_sentiment package it imports — nothing else.

# Dependencies / build output (Vercel installs and builds these itself).
node_modules/
.next/

# Python CLI surface that is not used by the serverless function.
app.py
main.py
settings.py
pyproject.toml
Dockerfile
.dockerignore

# Tests, CI, and local tooling.
tests/
.github/
.idea/
.agent/

# Generated artifacts and caches.
output/
__pycache__/
*.pyc
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
